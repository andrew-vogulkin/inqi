# Postgres (single datastore: data + queue + realtime)
DATABASE_URL=postgresql://inqi:inqi@localhost:5432/inqi?schema=public

# Backend
PORT=4000
# CORS allowlist (comma-separated, or '*'). Unset = local dev + https://inqi.monkeycode.io.
# WEB_ORIGIN=http://localhost:5173,https://inqi.monkeycode.io
PUBLIC_BASE_URL=http://localhost:4000

# Qwen (DashScope, OpenAI-compatible)
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Web-search tools for the AI (web/maps/social/translate/currency), bound via DI.
# WEBSEARCH_DRIVER=searxng            # searxng (self-hosted, default) | cloud (future)
WEBSEARCH_BASE_URL=https://orange.tail035fe2.ts.net:8443
# WEBSEARCH_TIMEOUT_MS=10000
# WEBSEARCH_MAX_RESULTS=8

# Breadth/depth research limits (report × inquiry × source matrix; all queue tasks).
# Breadth discovery creates at most this many inquiries per report (funnel hard cap):
# BREADTH_MAX_INQUIRIES=8
# Depth gathers at most this many sources per inquiry; ≥1 slot is always reserved
# for the email thread (email sources themselves are not capped):
# SOURCES_MAX_PER_INQUIRY=5
# Depth agent tool budget (web_search + open_url calls per CYCLE):
# DEPTH_AGENT_MAX_TOOLCALLS=6
# Adaptive research loops — HARD CAPS, not targets. Breadth cycles (relax → re-search)
# until the funnel target is met, the search goes dry (2 rounds with no new finds), or
# the model has no new queries; depth refine cycles continue while the evaluation gate
# names NEW gaps (evidence sufficient → stop; same gaps twice → stalled, stop):
# BREADTH_MAX_CYCLES=50
# DEPTH_AGENT_CYCLES=150
# Stop WAITING on a silent provider after this long: the inquiry is marked unresponsive (never failed) — the thread stays open and a late reply re-evaluates the report
# REPLY_TIMEOUT_MINUTES=240
# Headless-browser page reader (the depth agent's open_url tool):
# BROWSER_PAGE_TIMEOUT_MS=15000
# BROWSER_PAGE_MAX_CHARS=6000

# Questionnaire link
QUESTIONNAIRE_TTL_HOURS=72
# Orchestrator model sizing (breadth = cheap, depth = strong)
QWEN_MODEL_BREADTH=qwen-turbo
QWEN_MODEL_DEPTH=qwen-max

# Inbound email (agent communication track)
INBOUND_DOMAIN=reply.inqi.example   # subject-provider replies arrive at <token>@INBOUND_DOMAIN
SIMULATE_REPLIES=true               # demo: auto-generate a subject-provider reply after send (follow-ups too, max 3 per thread)
# SIMULATE_REPLY_IGNORE_RATE=0.2    # fraction of simulated providers who never reply (exercises the reply-timeout path)

# Email provider. MAIL_DRIVER picks the transport for ALL outbound (vendor
# outreach + customer notifications + emailed MFA codes): `local` captures to disk
# (+ simulated replies when SIMULATE_REPLIES=true), `postmark` sends for real.
# Unset → auto: Postmark when a real token is present, else local.
# MAIL_DRIVER=local
POSTMARK_SERVER_TOKEN=pm-xxxx
POSTMARK_FROM=inquiry@inqi.example   # verified sender signature / domain

# Auth — two-step email sign-in (email → MFA code).
#   MFA_TRANSPORT=mock  (default) — every sign-in accepts MFA_MOCK_CODE; nothing emailed.
#   MFA_TRANSPORT=email           — a per-attempt random code is emailed via MAIL_PROVIDER
#                                   and required on verify (the mock code no longer works).
# MFA_TRANSPORT=mock
MFA_MOCK_CODE=123456
# MFA_CODE_TTL_MS=600000              # emailed-code lifetime (default 10 min)
# Roles live in the DB: new accounts default to `customer`; admins are marked manually
# (`pnpm --filter @inqi/backend db:promote-admin <email>`). No email allowlist.
SESSION_SECRET=change-me             # HMAC session signing key (required in prod)

# Credits (HP-19) — flat credits to run one report (reserve→charge/refund).
REPORT_COST_CREDITS=1
# Local model provider queue: max parallel requests to the local backend (spark);
# beyond it requests wait in strict FIFO order so every job gets honest flow:
# LOCAL_AI_CONCURRENCY=1
