# Postgres (single datastore: data + queue + realtime)
DATABASE_URL=postgresql://inqi:inqi@localhost:5432/inqi?schema=public

# Backend
PORT=4000
# CORS allowlist (comma-separated, or '*'). Unset = local dev + https://inqi.monkeycode.io.
# WEB_ORIGIN=http://localhost:5173,https://inqi.monkeycode.io
PUBLIC_BASE_URL=http://localhost:4000

# Qwen (DashScope, OpenAI-compatible)
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Questionnaire link
QUESTIONNAIRE_TTL_HOURS=72
# Orchestrator model sizing (breadth = cheap, depth = strong)
QWEN_MODEL_BREADTH=qwen-turbo
QWEN_MODEL_DEPTH=qwen-max

# Inbound email (agent communication track)
INBOUND_DOMAIN=reply.inqi.example   # subject-provider replies arrive at <token>@INBOUND_DOMAIN
SIMULATE_REPLIES=true               # demo: auto-generate a subject-provider reply after send

# Email provider = Postmark (chosen: simplest send + native inbound parse webhook)
POSTMARK_SERVER_TOKEN=pm-xxxx
POSTMARK_FROM=inquiry@inqi.example   # verified sender signature / domain

# Auth (HP-10) — set GOOGLE_CLIENT_ID to use real Google sign-in (else stub verifier).
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_EMAILS=ops@monkeycode.io       # comma-separated admin allowlist (or ADMIN_DOMAIN)
SESSION_SECRET=change-me             # HMAC session signing key (required in prod)

# Credits (HP-19) — flat credits to run one report (reserve→charge/refund).
REPORT_COST_CREDITS=1
