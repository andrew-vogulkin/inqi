# inqi production env — copy to deploy/.env on the ECS, fill every REQUIRED value,
# chmod 600. Never commit the filled file. Vars not listed here keep their code
# defaults (see backend ConfigService); the ones below are what a prod go-live needs.

# ── Images (GHCR or Alibaba ACR refs published by release.yml) ──────────────
INQI_BACKEND_IMAGE=ghcr.io/andrew-vogulkin/inqi-backend:latest   # REQUIRED
INQI_FRONTEND_IMAGE=ghcr.io/andrew-vogulkin/inqi-frontend:latest # REQUIRED

# ── Public host / TLS ───────────────────────────────────────────────────────
INQI_DOMAIN=inqi.monkeycode.io                # REQUIRED — Caddy TLS + A record
PUBLIC_BASE_URL=https://inqi.monkeycode.io    # REQUIRED — email links, reply addrs
WEB_BASE_URL=https://inqi.monkeycode.io
WEB_ORIGIN=https://inqi.monkeycode.io         # CORS allowlist (comma-sep)

# ── Database (on-box Postgres container; must match compose) ─────────────────
POSTGRES_USER=inqi
POSTGRES_PASSWORD=CHANGE_ME_STRONG            # REQUIRED
POSTGRES_DB=inqi
# host = the compose service name `db`; ?schema=public for Prisma + pg-boss.
DATABASE_URL=postgresql://inqi:CHANGE_ME_STRONG@db:5432/inqi?schema=public  # REQUIRED

# ── Auth / session ──────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_LONG_RANDOM          # REQUIRED (openssl rand -hex 32)
# MFA_MOCK_CODE is still a mocked OTP — real emailed OTP is a follow-up.
MFA_MOCK_CODE=123456

# ── Qwen Cloud (Alibaba DashScope, OpenAI-compatible) ───────────────────────
AI_DRIVER=qwen_cloud
QWEN_API_KEY=sk-REPLACE_WITH_DASHSCOPE_KEY     # REQUIRED
# Generic INTL endpoint. If your Model Studio workspace is region-scoped, use
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MODEL_BREADTH=qwen-turbo
QWEN_MODEL_DEPTH=qwen-max

# ── Web search (SearXNG on home-lab `orange`, over Tailscale) ───────────────
# Host joins the tailnet (see README); compose pins this name → orange's tailnet IP.
WEBSEARCH_DRIVER=searxng
WEBSEARCH_BASE_URL=https://orange.tail035fe2.ts.net:8443

# ── Mail: Postmark (REAL send + inbound), simulation OFF ────────────────────
# NOTE: until the Postmark server is APPROVED it only delivers to the verified
# sender domain, so ALL outbound is hard-redirected to andrei@monkeycode.io
# (OUTBOUND_TO_OVERRIDE const in backend/src/domain/source/mail.provider.ts).
# Real recipient is kept in the subject tag + X-Original-To. Set that const to ''
# once Postmark approves the server.
MAIL_DRIVER=postmark                           # explicit; wins over auto-detect
SIMULATE_REPLIES=false                         # REQUIRED for real go-live
POSTMARK_SERVER_TOKEN=REPLACE_WITH_POSTMARK_TOKEN   # REQUIRED
POSTMARK_FROM=marlowe.v@monkeycode.io          # verified sender signature
INBOUND_DOMAIN=inqi-postmark-reply.monkeycode.io    # inbound MX (already live)

# ── Inbound webhook auth (embedded in the Postmark webhook URL) ─────────────
WEBHOOK_INBOUND_USER=inqi                       # REQUIRED
WEBHOOK_INBOUND_PASS=CHANGE_ME_STRONG           # REQUIRED

# ── Credits ─────────────────────────────────────────────────────────────────
REPORT_COST_CREDITS=1
